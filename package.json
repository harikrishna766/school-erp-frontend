{
  "name": "school-erp-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:mock": "ng serve --configuration mock",
    "build": "ng build",
    "build:mock": "ng build --configuration mock-production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "test:cov": "ng test --watch=false --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json && tsc -p e2e/tsconfig.json",
    "icons:check": "node scripts/icons.mjs --check",
    "icons:sync": "node scripts/icons.mjs --write",
    "size:check": "node scripts/check-bundle-size.mjs",
    "api:generate": "openapi-generator-cli generate --generator-key school-erp-api",
    "prepare": "husky",
    "api:fetch": "node scripts/fetch-openapi.mjs",
    "api:update": "npm run api:fetch && npm run api:generate",
    "catalog:sync": "node scripts/sync-backend-catalog.mjs",
    "i18n:check": "node scripts/i18n-check.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/animations": "^22.3.0",
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/material": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@angular/service-worker": "^22.3.0",
    "@ngrx/signals": "^22.0.1",
    "@ngx-translate/core": "^18.1.0",
    "@ngx-translate/http-loader": "^18.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@openapitools/openapi-generator-cli": "^2.43.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.1",
    "angular-eslint": "22.8.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.2",
    "msw": "^3.0.7",
    "postcss": "^8.5.33",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.2",
    "vitest": "^5.0.0"
  },
  "description": "Multi-tenant School Management System \u2014 Angular frontend",
  "engines": {
    "node": ">=22.12 <23"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{scss,css,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
