      "get": {
        "operationId": "HealthController_live",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Process is alive"
          }
        },
        "summary": "Liveness probe",
        "tags": ["Health"]
      }
    },
    "/api/health/ready": {
      "get": {
        "operationId": "HealthController_ready",
        "parameters": [],
        "responses": {
          "200": {
            "description": "All dependencies healthy\n\nThe Health Check is successful",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/TerminusHealthCheckResult"
                    }
                  ],
                  "properties": {
                    "status": {
                      "enum": ["ok", "degraded"],
                      "example": "ok"
                    },
                    "error": {
                      "example": {}
                    },
                    "details": {
                      "example": {
                        "database": {
                          "status": "up",
                          "responseTime": 12
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "A dependency is unhealthy\n\nThe Health Check is not successful",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/TerminusHealthCheckResult"
                    }
                  ],
                  "properties": {
                    "status": {
                      "enum": ["error", "shutting_down"],
                      "example": "error"
                    },
                    "error": {
                      "example": {
                        "redis": {
                          "status": "down",
                          "message": "Could not connect",
                          "responseTime": 3005
                        }
                      }
                    },
                    "details": {
                      "example": {
                        "database": {
                          "status": "up",
                          "responseTime": 12
                        },
                        "redis": {
                          "status": "down",
                          "message": "Could not connect",
                          "responseTime": 3005
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Readiness probe",
        "tags": ["Health"]
      }
    }
  },
  "info": {
    "title": "School ERP API",
    "description": "Multi-tenant School Management System. All responses use the standard envelope.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "MeUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": ["PLATFORM", "STAFF", "PARENT", "STUDENT"]
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "twoFactorEnabled": {
            "type": "boolean"
          }
        },
        "required": ["id", "type", "firstName", "twoFactorEnabled"]
      },
      "MeOrganizationDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "subdomain": {
            "type": "string"
          }
        },
        "required": ["id", "code", "name", "subdomain"]
      },
      "MeBranchDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": ["id", "code", "name"]
      },
      "MeRoleDto": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "branchId": {
            "type": "string",
            "nullable": true,
            "format": "uuid",
            "description": "NULL = all branches"
          }
        },
        "required": ["key", "name"]
      },
      "MeModuleDto": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "isCore": {
            "type": "boolean"
          },
          "plan": {
            "type": "string",
            "nullable": true,
            "enum": ["FREE", "BASIC", "STANDARD", "PREMIUM", "ENTERPRISE"]
          },
          "expiresAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          }
        },
        "required": ["key", "name", "isCore"]
      },
      "MePermissionDto": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "example": "students:student:view"
          },
          "scopes": {
            "type": "array",
            "description": "Distinct scopes granted by your roles",
            "items": {
              "type": "string",
              "enum": ["ALL", "BRANCH", "CLASS", "SECTION", "SELF", "OWN_CHILDREN"]
            }
          },
          "orgWide": {
            "type": "boolean",
            "description": "True if any grant covers the whole organization"
          },
          "branchIds": {
            "description": "Branches the granting role assignments are limited to",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["key", "scopes", "orgWide", "branchIds"]
      },
      "MeScopeDto": {
        "type": "object",
        "properties": {
          "staffId": {
            "type": "string",
            "nullable": true,
            "format": "uuid"
          },
          "studentId": {
            "type": "string",
            "nullable": true,
            "format": "uuid"
          },
          "sectionIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "classTeacherSectionIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "classIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "childStudentIds": {
            "description": "Guardian accounts: wards' student ids",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["sectionIds", "classTeacherSectionIds", "classIds", "childStudentIds"]
      },
      "MeAccessResponse": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/MeUserDto"
          },
          "organization": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/MeOrganizationDto"
              }
            ]
          },
          "activeBranchId": {
            "type": "string",
            "nullable": true,
            "format": "uuid"
          },
          "branches": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MeBranchDto"
            }
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MeRoleDto"
            }
          },
          "modules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MeModuleDto"
            }
          },
          "permissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MePermissionDto"
            }
          },
          "scope": {
            "$ref": "#/components/schemas/MeScopeDto"
          },
          "twoFactorSetupRequired": {
            "type": "boolean"
          }
        },
        "required": [
          "user",
          "branches",
          "roles",
          "modules",
          "permissions",
          "scope",
          "twoFactorSetupRequired"
        ]
      },
      "OrgModuleResponse": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "isCore": {
            "type": "boolean"
          },
          "enabled": {
            "type": "boolean"
          },
          "plan": {
            "type": "string",
            "nullable": true,
            "enum": ["FREE", "BASIC", "STANDARD", "PREMIUM", "ENTERPRISE"]
          },
          "expiresAt": {
            "format": "date-time",
            "type": "string",
            "nullable": true
          },
          "limits": {
            "type": "object"
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["key", "name", "isCore", "enabled", "limits", "dependsOn"]
      },
      "UpdateOrgModuleDto": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "plan": {
            "enum": ["FREE", "BASIC", "STANDARD", "PREMIUM", "ENTERPRISE"],
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "limits": {
            "type": "object",
            "additionalProperties": true,
            "example": {
              "maxStudents": 2000
            }
          }
        },
        "required": ["enabled"]
      },
      "RoleSummaryResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "isSystem": {
            "type": "boolean"
          },
          "permissionCount": {
            "type": "number"
          }
        },
        "required": ["id", "key", "name", "isSystem", "permissionCount"]
      },
      "RolePermissionInput": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*:[a-z][a-z0-9_-]*:[a-z][a-z0-9_-]*$",
            "example": "students:student:view"
          },
          "scope": {
            "enum": ["ALL", "BRANCH", "CLASS", "SECTION", "SELF", "OWN_CHILDREN"],
            "type": "string"
          }
        },
        "required": ["key", "scope"]
      },
      "RoleDetailResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "isSystem": {
            "type": "boolean"
          },
          "permissionCount": {
            "type": "number"
          },
          "permissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RolePermissionInput"
            }
          }
        },
        "required": ["id", "key", "name", "isSystem", "permissionCount", "permissions"]
      },
      "CreateRoleDto": {
        "type": "object",
        "properties": {
          "permissions": {
            "maxItems": 500,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RolePermissionInput"
            }
          },
          "key": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,59}$",
            "example": "EXAM_COORDINATOR",
            "description": "UPPER_SNAKE_CASE, unique per organization"
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100,
            "example": "Exam Coordinator"
          },
          "description": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": ["permissions", "key", "name"]
      },
      "SetRolePermissionsDto": {
        "type": "object",
        "properties": {
          "permissions": {
            "maxItems": 500,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RolePermissionInput"
            }
          }
        },
        "required": ["permissions"]
      },
      "UserRoleResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "roleId": {
            "type": "string",
            "format": "uuid"
          },
          "branchId": {
            "type": "string",
            "nullable": true,
            "format": "uuid"
          }
        },
        "required": ["id", "userId", "roleId"]
      },
      "AssignRoleDto": {
        "type": "object",
        "properties": {
          "roleId": {
            "type": "string",
            "format": "uuid"
          },
          "branchId": {
            "type": "string",
            "format": "uuid",
            "description": "Omit to assign in every branch"
          }
        },
        "required": ["roleId"]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "maxLength": 100,
            "description": "Stable client-generated device identifier"
          },
          "deviceName": {
            "type": "string",
            "maxLength": 100,
            "example": "Asha's iPhone"
          },
          "orgCode": {
            "type": "string",
            "maxLength": 63,
            "description": "Organization code or subdomain. Omit for platform (super admin) login.",
            "example": "demo"
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "example": "admin@demo.school.test"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "example": "Demo@12345"
          }
        },
        "required": ["email", "password"]
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "twoFactorRequired": {
            "type": "boolean",
            "description": "When true, call /auth/2fa/verify with challengeToken"
          },
          "challengeToken": {
            "type": "string"
          },
          "challengeExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "tokenType": {
            "enum": ["Bearer"],
            "type": "string"
          },
          "accessToken": {
            "type": "string"
          },
          "accessTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "refreshToken": {
            "type": "string"
          },
          "refreshTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "sessionId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": ["twoFactorRequired"]
      },
      "TwoFactorLoginDto": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "maxLength": 100,
            "description": "Stable client-generated device identifier"
          },
          "deviceName": {
            "type": "string",
            "maxLength": 100,
            "example": "Asha's iPhone"
          },
          "challengeToken": {
            "type": "string",
            "description": "challengeToken returned by /auth/login"
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "description": "6-digit authenticator code",
            "example": "123456"
          },
          "recoveryCode": {
            "type": "string",
            "maxLength": 20,
            "description": "Single-use recovery code instead of `code`",
            "example": "ABCDE-FGHIJ"
          }
        },
        "required": ["challengeToken"]
      },
      "TokensResponse": {
        "type": "object",
        "properties": {
          "tokenType": {
            "enum": ["Bearer"],
            "type": "string"
          },
          "accessToken": {
            "type": "string"
          },
          "accessTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "refreshToken": {
            "type": "string"
          },
          "refreshTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "sessionId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "tokenType",
          "accessToken",
          "accessTokenExpiresAt",
          "refreshToken",
          "refreshTokenExpiresAt",
          "sessionId"
        ]
      },
      "OtpRequestDto": {
        "type": "object",
        "properties": {
          "orgCode": {
            "type": "string",
            "maxLength": 63,
            "example": "demo"
          },
          "phone": {
            "type": "string",
            "description": "E.164 phone number",
            "example": "+919810000001"
          }
        },
        "required": ["orgCode", "phone"]
      },
      "AcceptedResponse": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "boolean",
            "example": true
          },
          "expiresInSec": {
            "type": "number",
            "description": "OTP validity in seconds"
          }
        },
        "required": ["accepted"]
      },
      "OtpVerifyDto": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "maxLength": 100,
            "description": "Stable client-generated device identifier"
          },
          "deviceName": {
            "type": "string",
            "maxLength": 100,
            "example": "Asha's iPhone"
          },
          "orgCode": {
            "type": "string",
            "maxLength": 63,
            "example": "demo"
          },
          "phone": {
            "type": "string",
            "example": "+919810000001"
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "example": "482913"
          }
        },
        "required": ["orgCode", "phone", "code"]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "maxLength": 100,
            "description": "Stable client-generated device identifier"
          },
          "deviceName": {
            "type": "string",
            "maxLength": 100,
            "example": "Asha's iPhone"
          },
          "refreshToken": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": ["refreshToken"]
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {
          "orgCode": {
            "type": "string",
            "maxLength": 63,
            "example": "demo"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "anita.sharma@demo.school.test"
          }
        },
        "required": ["email"]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 200
          },
          "newPassword": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128
          }
        },
        "required": ["token", "newPassword"]
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "maxLength": 128
          },
          "newPassword": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128
          }
        },
        "required": ["currentPassword", "newPassword"]
      },
      "SessionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "current": {
            "type": "boolean"
          },
          "deviceId": {
            "type": "string",
            "nullable": true
          },
          "deviceName": {
            "type": "string",
            "nullable": true
          },
          "userAgent": {
            "type": "string",
            "nullable": true
          },
          "ip": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "lastUsedAt": {
            "format": "date-time",
            "type": "string",
            "nullable": true
          },
          "expiresAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": ["id", "current", "createdAt", "expiresAt"]
      },
      "TwoFactorSetupResponse": {
        "type": "object",
        "properties": {
          "secret": {
            "type": "string",
            "description": "Base32 secret for manual entry"
          },
          "otpauthUrl": {
            "type": "string",
            "description": "Render as a QR code for authenticator apps"
          }
        },
        "required": ["secret", "otpauthUrl"]
      },
      "TwoFactorCodeDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "example": "123456"
          }
        },
        "required": ["code"]
      },
      "RecoveryCodesResponse": {
        "type": "object",
        "properties": {
          "recoveryCodes": {
            "description": "Shown once. Store safely.",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["recoveryCodes"]
      },
      "DisableTwoFactorDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "example": "123456"
          },
          "password": {
            "type": "string",
            "maxLength": 128
          }
        },
        "required": ["code", "password"]
      },
      "TerminusHealthIndicatorResult": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["up", "degraded", "down"],
            "description": "The status of this health indicator"
          },
          "responseTime": {
            "type": "number",
            "description": "Time the health indicator took to respond, in ms"
          },
          "cachedResponse": {
            "type": "boolean",
            "description": "Whether this result was served from the cache"
          }
        },
        "required": ["status"]
      },
      "TerminusHealthCheckResult": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["error", "ok", "degraded", "shutting_down"],
            "example": "ok"
          },
          "info": {
            "type": "object",
            "additionalProperties": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/TerminusHealthIndicatorResult"
                },
                {
                  "type": "object",
                  "additionalProperties": true
                }
              ]
            },
            "example": {
              "database": {
                "status": "up",
                "responseTime": 12
              }
            },
            "nullable": true
          },
          "error": {
            "type": "object",
            "additionalProperties": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/TerminusHealthIndicatorResult"
                },
                {
                  "type": "object",
                  "additionalProperties": true
                }
              ]
            },
            "example": {},
            "nullable": true
          },
          "details": {
            "type": "object",
            "additionalProperties": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/TerminusHealthIndicatorResult"
                },
                {
                  "type": "object",
                  "additionalProperties": true
                }
              ]
            },
            "example": {
              "database": {
                "status": "up",
                "responseTime": 12
              }
            }
          }
        },
        "required": ["status", "details"]
      }
    }
  }
}
