{
  "$schema": "./node_modules/@openapitools/openapi-generator-cli/config.schema.json",
  "spaces": 2,
  "generator-cli": {
    "version": "7.17.0",
    "generators": {
      "school-erp-api": {
        "generatorName": "typescript-angular",
        "inputSpec": "#{cwd}/openapi/school-erp-api.json",
        "output": "#{cwd}/src/app/api/generated",
        "skipValidateSpec": false,
        "additionalProperties": {
          "ngVersion": "20.0.0",
          "providedIn": "root",
          "fileNaming": "kebab-case",
          "stringEnums": true,
          "enumPropertyNaming": "UPPERCASE",
          "useSingleRequestParameter": true,
          "supportsES6": true,
          "withInterfaces": true,
          "paramsInPath": false
        },
        "globalProperty": {
          "skipFormModel": "false"
        }
      }
    }
  }
}
